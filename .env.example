# .env.example — TTC Transit Reliability Analytics
#
# Copy this file to `.env` (no extension prefix) at the project root, then
# replace the placeholders with your actual Postgres credentials.
# The real `.env` is gitignored — never commit your password.
#
# DATABASE_URL format (SQLAlchemy / psycopg2):
#   postgresql://<user>:<password>@<host>:<port>/<database>
#
# Defaults for a fresh local pgAdmin 4 install:
#   user     = postgres
#   host     = localhost
#   port     = 5432
#   database = ttc_reliability   (after you run sql/00_create_database.sql)

DATABASE_URL=postgresql://postgres:YOUR_PASSWORD_HERE@localhost:5432/ttc_reliability
